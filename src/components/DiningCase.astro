---
import Base from '../layouts/Base.astro';
const { english = false } = Astro.props;
const t = (zh: string, en: string) => english ? en : zh;
const root = english ? '/en' : '';
const title = t('网格渔村：AI into Dining · Kateiso Cao', 'Wangge Yucun: AI into Dining · Kateiso Cao');
const description = t('曹益波（Kateiso Cao）的餐饮数字化实践：为网格渔村连接品牌、套餐、短视频工作流与顾客运营。', 'Kateiso Cao’s hospitality project at Wangge Yucun connects brand design, meal packages, short-video workflows and customer operations.');
---
<Base title={title} description={description} lang={english ? 'en' : 'zh-Hans'} canonical={`${root}/projects/ai-into-dining.html`} alternates={[{ href: `${english ? '' : '/en'}/projects/ai-into-dining.html`, hrefLang: english ? 'zh-Hans' : 'en' }]} languageToggle={{ href: `${english ? '' : '/en'}/projects/ai-into-dining.html`, label: english ? '中文' : 'EN' }} jsonLd={{'@context':'https://schema.org','@type':'CreativeWork',name:'AI into Dining — Wangge Yucun',creator:{'@id':'https://kateiso.dev/#person'},url:`https://kateiso.dev${root}/projects/ai-into-dining.html`,description}}>
  <article class="dining-case">
    <a href={`${root}/projects.html`}>{t('返回项目', 'Back to projects')}</a>
    <h1>{t('把 AI 带进真实的餐厅。', 'Bringing AI into a working restaurant.')}</h1>
    <p class="dining-case__intro">{t('网格渔村 / AI into Dining', 'Wangge Yucun / AI into Dining')}</p>
    <p>{t('我是曹益波（Kateiso Cao）。这项餐饮数字化实践从 2024 年开始，围绕品牌、产品套餐、内容发布和顾客运营展开。', 'I’m Kateiso Cao (曹益波, also Yibo Cao). This hospitality digitalization project began in 2024 and covers brand design, meal packages, content publishing and customer operations.')}</p>
    <h2>{t('要解决的问题', 'The problem')}</h2>
    <p>{t('品牌表达、套餐设计、短视频内容与到店后的顾客运营，需要形成连贯的体验。', 'Brand presentation, meal packages, short-video content and the customer experience in the restaurant need to work together.')}</p>
    <h2>{t('我做的工作', 'My work')}</h2>
    <ul><li>{t('统一品牌设计。', 'Unified brand design.')}</li><li>{t('搭建全域套餐体系。', 'Built a meal-package system across channels.')}</li><li>{t('搭建自动短视频发布工作流。', 'Built an automated short-video publishing workflow.')}</li><li>{t('围绕获客、留存与复购连接顾客运营。', 'Connected customer operations across acquisition, retention and repeat visits.')}</li></ul>
    <h2>{t('当前状态', 'Current status')}</h2>
    <p>{t('项目已商业化并产生收入。具体收入、增长幅度和客户数据尚未公开。', 'The project has been commercialized and has generated revenue. Revenue figures, growth rates and customer data have not been published.')}</p>
    <p>{t('这里记录已开展的工作；后续会补充可公开的案例细节。', 'This page records the work carried out so far. Further public case details will be added as they become available.')}</p>
    <a href={`${root}/contact.html`}>{t('与我讨论餐饮数字化', 'Discuss hospitality digitalization')}</a>
  </article>
<style>
.dining-case{max-width:850px;margin:0 auto;padding:70px 24px 100px}.dining-case h1{font-size:clamp(36px,5vw,64px);line-height:1.2;letter-spacing:-.04em;margin:35px 0 24px}.dining-case__intro{font-size:24px}.dining-case h2{margin:48px 0 18px;font-size:28px}.dining-case p,.dining-case li{line-height:1.9;max-width:70ch}.dining-case>a{display:inline-block;margin-top:25px;text-decoration:underline;text-underline-offset:5px}
</style>
</Base>
