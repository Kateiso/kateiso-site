---
import Base from "../../src/layouts/Base.astro";
import fs from 'node:fs/promises';
import { normalizeGalleryItems } from '../utils/gallery';

const pageTitle = '相册 · Kateiso Cao';
const pageDesc = 'Instagram 风格照片与视频流，记录 XR、旅途与日常。';

let items = [] as any[];
try {
  const raw = await fs.readFile('public/assets/data/gallery.json', 'utf8');
  const json = JSON.parse(raw);
  items = normalizeGalleryItems(json.items || []);
} catch {}

const years = Array.from(new Set(items.map((i) => (i.date || '').slice(0, 4))))
  .filter(Boolean)
  .sort((a, b) => (a < b ? 1 : -1));

const url = new URL(Astro.request.url);
const activeYear = url.searchParams.get('year');
const filtered = activeYear ? items.filter((i) => (i.date || '').startsWith(activeYear)) : items;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  inLanguage: 'zh-Hans',
  url: 'https://kateiso.dev/photos.html'
};
---
<Base
  title={pageTitle}
  description={pageDesc}
  lang="zh-Hans"
  canonical="/photos.html"
  jsonLd={jsonLd}
>
  <section class="section photos-page photos-page--immersive">
    <div class="section__intro section__intro--split">
      <div>
        <h1>相册流</h1>
        <p class="section__lede">像刷 Instagram 一样看照片和视频，沉浸、顺滑、无黑白边。</p>
      </div>
      <nav aria-label="Year filter" class="photos-filter">
        <a href="/photos.html" class={activeYear ? '' : 'is-active'}>全部</a>
        {years.map((y) => <a href={`/photos.html?year=${y}`} class={activeYear === y ? 'is-active' : ''}>{y}</a>)}
      </nav>
    </div>

    <div class="photo-stream" id="photo-stream">
      {filtered.map((it, index) => (
        <article class="photo-stream__card">
          <button class="photo-stream__media-wrap" data-index={index} aria-label={`查看 ${it.title}`}>
            {it.video ? (
              <video
                class="photo-stream__media"
                src={it.video.src}
                poster={it.video.poster}
                muted
                playsinline
                preload="metadata"
                loop
              ></video>
            ) : (
              <img
                class="photo-stream__media"
                src={it.image.md}
                srcset={`${it.image.sm} 480w, ${it.image.md} 960w, ${it.image.lg} 1600w`}
                sizes="(max-width: 800px) 100vw, 50vw"
                alt={it.title}
                loading={index < 4 ? 'eager' : 'lazy'}
              />
            )}
          </button>
          <div class="photo-stream__meta">
            <p class="photo-stream__title">{it.title}</p>
            <p class="photo-stream__date">{it.date}</p>
            <div class="photo-stream__actions">
              <button class="photo-stream__action photo-stream__action--like" type="button" aria-label="喜欢这条内容">♥</button>
              <button class="photo-stream__action" type="button" data-index={index} aria-label="全屏查看">全屏</button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="photo-viewer" id="photo-viewer" hidden>
    <button class="photo-viewer__backdrop" data-action="close" aria-label="关闭查看器"></button>
    <div class="photo-viewer__panel" role="dialog" aria-modal="true" aria-label="媒体查看器">
      <button class="photo-viewer__close" data-action="close" aria-label="关闭">✕</button>
      <button class="photo-viewer__nav photo-viewer__nav--prev" aria-label="上一条">‹</button>
      <button class="photo-viewer__nav photo-viewer__nav--next" aria-label="下一条">›</button>
      <div class="photo-viewer__media" id="photo-viewer-media"></div>
      <footer class="photo-viewer__meta">
        <p id="photo-viewer-title"></p>
        <p id="photo-viewer-date"></p>
      </footer>
    </div>
  </div>

  <script>
    const items = JSON.parse(document.getElementById('photos-data')?.textContent || '[]');
    const viewer = document.getElementById('photo-viewer');
    const media = document.getElementById('photo-viewer-media');
    const title = document.getElementById('photo-viewer-title');
    const date = document.getElementById('photo-viewer-date');
    let currentIndex = 0;

    function prefetch(index) {
      const it = items[index];
      if (!it || !it.image?.md) return;
      const img = new Image();
      img.src = it.image.md;
    }

    function render(index) {
      const it = items[index];
      if (!it) return;
      title.textContent = it.title || '';
      date.textContent = it.date || '';
      media.innerHTML = '';

      if (it.video?.src) {
        const v = document.createElement('video');
        v.src = it.video.src;
        v.poster = it.video.poster || it.image?.lg || '';
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.className = 'photo-viewer__asset';
        media.appendChild(v);
      } else {
        const img = document.createElement('img');
        img.src = it.image?.lg || it.image?.md || '';
        img.alt = it.title || '';
        img.className = 'photo-viewer__asset';
        media.appendChild(img);
      }

      prefetch((index + 1) % items.length);
      prefetch((index - 1 + items.length) % items.length);
    }

    function openAt(index) {
      if (!items.length) return;
      currentIndex = (index + items.length) % items.length;
      render(currentIndex);
      viewer.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeViewer() {
      viewer.hidden = true;
      document.body.style.overflow = '';
      const v = media.querySelector('video');
      if (v) v.pause();
    }

    function go(delta) {
      openAt(currentIndex + delta);
    }

    document.querySelectorAll('[data-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index') || '0');
        openAt(idx);
      });
    });

    viewer?.addEventListener('click', (event) => {
      if (event.target?.dataset?.action === 'close') {
        closeViewer();
      }
    });

    document.querySelector('.photo-viewer__nav--prev')?.addEventListener('click', () => go(-1));
    document.querySelector('.photo-viewer__nav--next')?.addEventListener('click', () => go(1));

    document.addEventListener('keydown', (event) => {
      if (viewer.hidden) return;
      if (event.key === 'Escape') closeViewer();
      if (event.key === 'ArrowLeft') go(-1);
      if (event.key === 'ArrowRight') go(1);
    });
  </script>
  <script type="application/json" id="photos-data" set:html={JSON.stringify(filtered)}></script>
</Base>
